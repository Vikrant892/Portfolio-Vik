---
import '../styles/globals.css';
import Header from '../components/Header.astro';
import AssetProtection from '../components/AssetProtection.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Vikrant Sharma. ML engineer specialising in cybersecurity. AWS Certified Data Engineer, OCI Data Science Pro. M.ICT student at USC Adelaide, graduating Aug 2027.',
  noindex = false,
} = Astro.props;

const fullTitle =
  title.toLowerCase() === 'home' ? 'Vikrant Sharma' : `${title}, Vikrant`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vikrant Sharma" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0a0e1a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top" class="min-h-svh bg-[var(--color-bg)] text-[var(--color-ink)]">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <AssetProtection />
  </body>
</html>
