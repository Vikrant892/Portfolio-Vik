---
const links = [
  { label: 'Work', href: '#projects' },
  { label: 'Experience', href: '#experience' },
  { label: 'Awards', href: '#awards' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  class="sticky top-0 z-40 border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)]/85 backdrop-blur supports-[backdrop-filter]:bg-[var(--color-bg)]/65"
>
  <div
    class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-6 py-4 sm:px-12"
  >
    <a
      href="#top"
      class="display-script text-2xl text-[var(--color-ink)] transition-colors hover:text-[var(--color-amber)]"
      aria-label="Vikrant, home"
    >
      Vikrant<span class="text-[var(--color-amber)]">.</span>
    </a>

    <nav aria-label="Primary" class="hidden gap-7 text-sm sm:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="mono text-xs uppercase tracking-widest text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="rounded-full bg-[var(--color-ink)] px-4 py-2 text-xs font-medium text-[var(--color-ink-on-dark)] transition-transform hover:-translate-y-0.5 sm:px-5 sm:py-2.5 sm:text-sm"
    >
      Get in touch
    </a>
  </div>
</header>
