---
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';
---

<section
  class="relative isolate overflow-hidden border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] pb-16 pt-12 sm:pt-16"
  aria-labelledby="hero-heading"
>
  {/* Soft sunset gradient backdrop, behind the photo */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_30%,_var(--color-amber-soft)_0%,_transparent_55%)] opacity-70"
  ></div>

  <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-8 px-6 sm:px-12 lg:grid-cols-12">
    {/* LEFT — script header, name, tagline, pill */}
    <div class="lg:col-span-7 lg:pt-8">
      <p class="ds-eyebrow mb-6">VIKRANT — DATA ENGINEER &amp; CYBERSECURITY ANALYST</p>

      <h1 id="hero-heading" class="display-script text-6xl text-[var(--color-ink)] sm:text-8xl lg:text-[10rem]">
        Hey<span class="text-[var(--color-amber)]">,</span><br />
        <span class="ml-[1.2em]">there</span>
      </h1>

      <p class="display-mark mt-12 text-5xl text-[var(--color-ink)] sm:text-7xl lg:text-[6.5rem]">
        I&nbsp;AM<br />VIKRANT<span class="text-[var(--color-amber)]">.</span>
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <span class="ds-pill">Available for new opportunities</span>
        <a
          href="#contact"
          class="rounded-full bg-[var(--color-ink)] px-5 py-2.5 text-sm font-medium text-[var(--color-ink-on-dark)] transition-transform hover:-translate-y-0.5"
        >
          Contact →
        </a>
      </div>
    </div>

    {/* RIGHT — portrait + role detail */}
    <div class="lg:col-span-5 lg:pt-12">
      <figure
        class="relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-subtle)] shadow-[var(--shadow-card)]"
      >
        <Image
          src={portrait}
          alt="Vikrant — portrait"
          widths={[480, 720, 1080]}
          sizes="(max-width: 1024px) 100vw, 480px"
          class="h-full w-full object-cover"
          loading="eager"
        />
      </figure>

      <p class="mt-8 max-w-sm text-base text-[var(--color-ink-muted)]">
        Master of IT student at USC Adelaide. I build production data systems,
        ML pipelines, and threat-detection platforms — currently looking for
        Data Engineer and Cybersecurity Analyst roles in Australia.
      </p>

      {/* Right-aligned mini stats */}
      <dl class="mono mt-8 grid grid-cols-3 gap-4 border-t border-[var(--color-border-subtle)] pt-6 text-sm">
        <div>
          <dt class="ds-eyebrow">Based in</dt>
          <dd class="mt-1 text-[var(--color-ink)]">Adelaide, AU</dd>
        </div>
        <div>
          <dt class="ds-eyebrow">Graduating</dt>
          <dd class="mt-1 text-[var(--color-ink)]">Aug 2027</dd>
        </div>
        <div>
          <dt class="ds-eyebrow">Email</dt>
          <dd class="mt-1 truncate text-[var(--color-ink)]">
            <a href="mailto:vikrantsharma892@gmail.com" class="hover:text-[var(--color-amber)]">
              get in touch
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  {/* Marquee-style scrolling tags at the bottom */}
  <div class="mt-20 overflow-hidden border-y border-[var(--color-border-subtle)] bg-[var(--color-bg-elevated)] py-6">
    <div class="mono flex animate-[scroll_40s_linear_infinite] gap-12 whitespace-nowrap text-sm text-[var(--color-ink-muted)]">
      {Array.from({ length: 2 }).map(() => (
        <>
          <span>DATA ENGINEERING</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>MACHINE LEARNING</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>CYBERSECURITY</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>NIDS / HIDS</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>SNOWFLAKE / REDSHIFT</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>PYTHON / SQL</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>OWASP / NIST CSF</span>
          <span class="text-[var(--color-amber)]">●</span>
          <span>ORACLE OCI CERTIFIED</span>
          <span class="text-[var(--color-amber)]">●</span>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [class*='animate-[scroll'] {
      animation: none !important;
    }
  }
</style>
