---
const services = [
  {
    n: '01',
    title: 'ML for Threat Detection',
    desc: 'My core focus. Building intrusion-detection models that map alerts to MITRE ATT&CK, anomaly classifiers on imbalanced data, phishing analysers that catch what email gateways miss. Most cyber analysts cannot build a model; most ML engineers do not know what ATT&CK is. I sit in the middle.',
    tools: ['scikit-learn', 'PyTorch', 'XGBoost', 'MITRE ATT&CK'],
  },
  {
    n: '02',
    title: 'Data Engineering',
    desc: 'How I feed the models. ETL pipelines, dimensional modelling on Snowflake and Redshift, real-time ingest, observability. Three months at Nagarro shipping production data work.',
    tools: ['Python', 'SQL', 'Snowflake', 'Airflow'],
  },
  {
    n: '03',
    title: 'Cybersecurity Analysis',
    desc: 'How I learned what to detect. Seven months at AT SecurDI doing SIEM triage, OWASP Top 10 web testing, ISO 27001 + NIST CSF audits. The hands-on knowledge that informs every detection model I build.',
    tools: ['SIEM', 'OWASP', 'NIST CSF', 'ISO 27001'],
  },
  {
    n: '04',
    title: 'Full-Stack Delivery',
    desc: 'How I ship the work. Dashboards, APIs, and demos that turn the model output into something humans can actually use. Flask, FastAPI, React, Astro, Docker, Cloudflare Pages, Hugging Face Spaces.',
    tools: ['Flask', 'FastAPI', 'Docker', 'Astro / React'],
  },
];
---

<section
  id="services"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">WHAT I CAN HELP YOU WITH</p>
        <h2
          id="services-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Services<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <p class="text-base text-[var(--color-ink-muted)] lg:col-span-5">
        ML for cybersecurity is the lead. The other three are how I get the
        model into production. Real shipped work across all four. Click any
        live demo below to see the actual code.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <article class="group relative bg-[var(--color-bg-elevated)] p-8 transition-colors hover:bg-[var(--color-bg)]">
            <p class="mono text-sm text-[var(--color-amber)]">{s.n}</p>
            <h3 class="display-script mt-6 text-3xl text-[var(--color-ink)]">
              {s.title}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {s.desc}
            </p>
            <ul class="mono mt-6 flex flex-wrap gap-2">
              {s.tools.map((t) => (
                <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-ink-dim)]">
                  {t}
                </li>
              ))}
            </ul>
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-amber)] transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:w-full"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
