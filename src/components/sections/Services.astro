---
const services = [
  {
    n: '01',
    title: 'Data Engineering',
    desc: 'ETL pipelines, dimensional modelling on Snowflake / Redshift, real-time ingest, observability. Production-grade, not just notebooks.',
    tools: ['Python', 'SQL', 'Snowflake', 'Airflow'],
  },
  {
    n: '02',
    title: 'Cybersecurity Analysis',
    desc: 'Threat detection systems, SIEM monitoring, incident response, vulnerability assessments, OWASP Top 10 testing, ISO 27001 / NIST CSF audits.',
    tools: ['SIEM', 'OWASP', 'NIST CSF', 'MITRE ATT&CK'],
  },
  {
    n: '03',
    title: 'Machine Learning',
    desc: 'End-to-end pipelines: feature engineering, ensemble models, threshold calibration, deployment to Streamlit / FastAPI services with real metrics.',
    tools: ['scikit-learn', 'PyTorch', 'XGBoost', 'SMOTE'],
  },
  {
    n: '04',
    title: 'Full-Stack & DevOps',
    desc: 'Building the dashboards and APIs that surface the data: Flask, FastAPI, React, Astro, Docker, Cloudflare Pages, Hugging Face Spaces.',
    tools: ['Flask', 'FastAPI', 'Docker', 'Astro / React'],
  },
];
---

<section
  id="services"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">WHAT I CAN HELP YOU WITH</p>
        <h2
          id="services-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Services<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <p class="text-base text-[var(--color-ink-muted)] lg:col-span-5">
        Four overlapping practices. Real shipped projects across each. See the
        Recent Projects section for live demos backed by actual code.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <article class="group relative bg-[var(--color-bg-elevated)] p-8 transition-colors hover:bg-[var(--color-bg)]">
            <p class="mono text-sm text-[var(--color-amber)]">{s.n}</p>
            <h3 class="display-script mt-6 text-3xl text-[var(--color-ink)]">
              {s.title}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {s.desc}
            </p>
            <ul class="mono mt-6 flex flex-wrap gap-2">
              {s.tools.map((t) => (
                <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-ink-dim)]">
                  {t}
                </li>
              ))}
            </ul>
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-amber)] transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:w-full"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
