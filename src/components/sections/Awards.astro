---
import { getCollection, render } from 'astro:content';

const awards = (await getCollection('awards')).sort((a, b) => b.data.year - a.data.year);
const rendered = await Promise.all(
  awards.map(async (a) => ({ entry: a, ...(await render(a)) })),
);
---

<section
  id="awards"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="awards-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16">
      <p class="ds-eyebrow mb-4">AWARDS &amp; RECOGNITION</p>
      <h2
        id="awards-heading"
        class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
      >
        Wins<span class="text-[var(--color-amber)]">.</span>
      </h2>
    </div>

    {
      rendered.length === 0 ? (
        <p class="mono text-sm text-[var(--color-ink-muted)]">
          More wins land here as Vikrant forwards them — ASUS Tournament 2v2, ROG Showdown, etc.
        </p>
      ) : (
        <ul class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {rendered.map(({ entry, Content }) => (
            <li>
              <article class="rounded-[var(--radius-xl)] border-2 border-[var(--color-amber)] bg-[var(--color-bg-elevated)] p-8">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="mono text-xs uppercase tracking-widest text-[var(--color-amber)]">
                      {entry.data.organisation} · {entry.data.year}
                    </p>
                    <h3 class="display-script mt-3 text-3xl text-[var(--color-ink)] sm:text-4xl">
                      {entry.data.title}
                    </h3>
                  </div>
                  {entry.data.tier && <span class="ds-pill flex-shrink-0">{entry.data.tier}</span>}
                </div>
                <div class="prose prose-sm mt-6 max-w-none text-[var(--color-ink-muted)] prose-strong:text-[var(--color-ink)] prose-strong:font-semibold prose-em:text-[var(--color-ink)] prose-a:text-[var(--color-amber)]">
                  <Content />
                </div>
                {entry.data.url && (
                  <a
                    href={entry.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono mt-6 inline-block text-xs text-[var(--color-ink)] underline-offset-4 hover:text-[var(--color-amber)] hover:underline"
                  >
                    See announcement ↗
                  </a>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
