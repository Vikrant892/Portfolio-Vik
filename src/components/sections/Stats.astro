---
const stats = [
  { value: '7', label: 'Live projects', sub: 'all on Hugging Face Spaces with source on GitHub' },
  { value: '8', label: 'Certifications', sub: 'led by Oracle OCI Data Science 2025' },
  { value: '10', label: 'Months of industry work', sub: 'Nagarro data engineering + AT SecurDI cyber' },
  { value: '2027', label: 'Graduating', sub: 'Master of IT, USC Adelaide' },
];
---

<section
  id="stats"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-ink)] py-24 text-[var(--color-ink-on-dark)] sm:py-32"
  aria-labelledby="stats-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="ds-eyebrow mb-4" style="color: var(--color-amber)">BY THE NUMBERS</p>
        <h2
          id="stats-heading"
          class="display-script text-5xl text-[var(--color-ink-on-dark)] sm:text-7xl"
        >
          The honest version<span class="text-[var(--color-amber)]">.</span>
        </h2>
        <p class="mt-8 max-w-md text-[var(--color-ink-on-dark-muted)]">
          Four numbers anyone can verify from this site, my GitHub, my LinkedIn,
          or my certification credentials. No rounded-up totals, no padded years.
        </p>
      </div>

      <dl class="grid grid-cols-2 gap-12 lg:col-span-6">
        {
          stats.map((s) => (
            <div class="border-l border-[var(--color-amber)] pl-6">
              <dt class="display-mark text-5xl text-[var(--color-amber)] sm:text-6xl">
                {s.value}
              </dt>
              <dd class="mt-4 text-base font-medium text-[var(--color-ink-on-dark)]">
                {s.label}
              </dd>
              <dd class="mono mt-1 text-xs text-[var(--color-ink-on-dark-muted)]">
                {s.sub}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
