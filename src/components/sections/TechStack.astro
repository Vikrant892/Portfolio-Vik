---
// Tech stack with simple-icons logos via CDN. Each item carries an
// optional simple-icons slug; items without a slug render as text-only
// pills (e.g., MITRE ATT&CK, SIEM, ISO 27001 have no official logo).
//
// simple-icons CDN docs: https://simpleicons.org/?modal=cdn

interface TechItem {
  name: string;
  slug?: string;
}

interface TechGroup {
  label: string;
  items: ReadonlyArray<TechItem>;
}

const groups: ReadonlyArray<TechGroup> = [
  {
    label: 'Languages',
    items: [
      { name: 'Python', slug: 'python' },
      { name: 'SQL' },
      { name: 'TypeScript', slug: 'typescript' },
      { name: 'JavaScript', slug: 'javascript' },
      { name: 'Bash', slug: 'gnubash' },
      { name: 'C', slug: 'c' },
    ],
  },
  {
    label: 'Data',
    items: [
      { name: 'Snowflake', slug: 'snowflake' },
      { name: 'Redshift', slug: 'amazonredshift' },
      { name: 'PostgreSQL', slug: 'postgresql' },
      { name: 'SQLite', slug: 'sqlite' },
      { name: 'Pandas', slug: 'pandas' },
      { name: 'NumPy', slug: 'numpy' },
      { name: 'Airflow', slug: 'apacheairflow' },
    ],
  },
  {
    label: 'ML & AI',
    items: [
      { name: 'scikit-learn', slug: 'scikitlearn' },
      { name: 'PyTorch', slug: 'pytorch' },
      { name: 'XGBoost' },
      { name: 'SMOTE' },
      { name: 'Streamlit', slug: 'streamlit' },
      { name: 'PIL' },
    ],
  },
  {
    label: 'Web & API',
    items: [
      { name: 'Flask', slug: 'flask' },
      { name: 'FastAPI', slug: 'fastapi' },
      { name: 'React', slug: 'react' },
      { name: 'Astro', slug: 'astro' },
      { name: 'Tailwind', slug: 'tailwindcss' },
      { name: 'Pydantic', slug: 'pydantic' },
    ],
  },
  {
    label: 'Security',
    items: [
      { name: 'MITRE ATT&CK' },
      { name: 'OWASP Top 10', slug: 'owasp' },
      { name: 'NIST CSF' },
      { name: 'ISO 27001' },
      { name: 'Suricata' },
      { name: 'SIEM' },
      { name: 'Wireshark', slug: 'wireshark' },
    ],
  },
  {
    label: 'Infra & DevOps',
    items: [
      { name: 'Docker', slug: 'docker' },
      { name: 'AWS', slug: 'amazonwebservices' },
      { name: 'OCI', slug: 'oracle' },
      { name: 'Cloudflare', slug: 'cloudflare' },
      { name: 'Hugging Face', slug: 'huggingface' },
      { name: 'GitHub Actions', slug: 'githubactions' },
      { name: 'Linux', slug: 'linux' },
    ],
  },
];
---

<section
  id="stack"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-elevated)] py-24 sm:py-32"
  aria-labelledby="stack-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">TOOLS OF THE TRADE</p>
        <h2
          id="stack-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Stack<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <p class="text-base text-[var(--color-ink-muted)] lg:col-span-5">
        Six categories. The tools I reach for on data engineering, machine
        learning, and security work. If you see something here, ask me about
        the project where I used it.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map((g, i) => (
          <article class="group relative bg-[var(--color-bg)] p-8 transition-colors hover:bg-[var(--color-bg-elevated)]">
            <div class="mono flex items-baseline justify-between text-xs">
              <span class="text-[var(--color-amber)]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="ds-eyebrow">{g.label}</span>
            </div>
            <ul class="mt-6 flex flex-wrap gap-2">
              {g.items.map((item) => (
                <li
                  class="tech-chip group/chip mono inline-flex items-center gap-1.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-2.5 py-1.5 text-xs text-[var(--color-ink)] transition-all duration-300 ease-[var(--ease-out-expo)] hover:-translate-y-0.5 hover:border-[var(--color-amber)] hover:bg-[var(--color-bg)] hover:shadow-sm"
                >
                  {item.slug ? (
                    <img
                      src={`https://cdn.simpleicons.org/${item.slug}`}
                      alt=""
                      aria-hidden="true"
                      width="14"
                      height="14"
                      loading="lazy"
                      class="tech-chip__icon h-3.5 w-3.5 shrink-0 transition-transform duration-300 group-hover/chip:scale-110"
                    />
                  ) : (
                    <span
                      aria-hidden="true"
                      class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-ink-faint)] transition-colors group-hover/chip:bg-[var(--color-amber)]"
                    />
                  )}
                  <span>{item.name}</span>
                </li>
              ))}
            </ul>
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-amber)] transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:w-full"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
