---
const groups = [
  {
    label: 'Languages',
    items: ['Python', 'SQL', 'TypeScript', 'JavaScript', 'Bash', 'C'],
  },
  {
    label: 'Data',
    items: ['Snowflake', 'Redshift', 'PostgreSQL', 'SQLite', 'Pandas', 'NumPy', 'Airflow'],
  },
  {
    label: 'ML & AI',
    items: ['scikit-learn', 'PyTorch', 'XGBoost', 'SMOTE', 'Streamlit', 'PIL'],
  },
  {
    label: 'Web & API',
    items: ['Flask', 'FastAPI', 'React', 'Astro', 'Tailwind', 'Pydantic'],
  },
  {
    label: 'Security',
    items: ['MITRE ATT&CK', 'OWASP Top 10', 'NIST CSF', 'ISO 27001', 'Suricata', 'SIEM', 'Wireshark'],
  },
  {
    label: 'Infra & DevOps',
    items: ['Docker', 'AWS', 'OCI', 'Cloudflare', 'Hugging Face', 'GitHub Actions', 'Linux'],
  },
];
---

<section
  id="stack"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-elevated)] py-24 sm:py-32"
  aria-labelledby="stack-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">TOOLS OF THE TRADE</p>
        <h2
          id="stack-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Stack<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <p class="text-base text-[var(--color-ink-muted)] lg:col-span-5">
        Six categories. The tools I reach for on data engineering, machine
        learning, and security work. If you see something here, ask me about
        the project where I used it.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map((g, i) => (
          <article class="group relative bg-[var(--color-bg)] p-8 transition-colors hover:bg-[var(--color-bg-elevated)]">
            <div class="mono flex items-baseline justify-between text-xs">
              <span class="text-[var(--color-amber)]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="ds-eyebrow">{g.label}</span>
            </div>
            <ul class="mt-6 flex flex-wrap gap-2">
              {g.items.map((item) => (
                <li class="mono rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3 py-1 text-xs text-[var(--color-ink)] transition-colors group-hover:border-[var(--color-amber)]">
                  {item}
                </li>
              ))}
            </ul>
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-amber)] transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:w-full"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
