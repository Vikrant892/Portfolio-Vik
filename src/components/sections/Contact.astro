---
const links = [
  { label: 'Email', value: 'vikrantsharma892@gmail.com', href: 'mailto:vikrantsharma892@gmail.com' },
  { label: 'GitHub', value: 'Vikrant892', href: 'https://github.com/Vikrant892' },
  { label: 'LinkedIn', value: 'vik892', href: 'https://www.linkedin.com/in/vik892/' },
  { label: 'Twitter', value: 'Vik69G', href: 'https://x.com/Vik69G' },
  { label: 'Blog', value: 'vikrant69g.com/blog', href: 'https://vikrant69g.com/blog' },
];
---

<footer
  id="contact"
  class="bg-[var(--color-ink)] py-24 text-[var(--color-ink-on-dark)] sm:py-32"
  aria-labelledby="contact-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-6" style="color: var(--color-amber)">
          AVAILABLE FOR DATA ENG &amp; CYBER ROLES — AUSTRALIA
        </p>
        <h2
          id="contact-heading"
          class="display-script text-5xl text-[var(--color-ink-on-dark)] sm:text-8xl"
        >
          Let's build<br />
          something good<span class="text-[var(--color-amber)]">.</span>
        </h2>
        <p class="mt-8 max-w-md text-[var(--color-ink-on-dark-muted)]">
          Open to full-time graduate / early-career roles in Adelaide and remote
          across AU. Best reached by email — I read everything.
        </p>
        <a
          href="mailto:vikrantsharma892@gmail.com"
          class="mt-10 inline-block rounded-full bg-[var(--color-amber)] px-8 py-4 font-medium text-[var(--color-ink)] transition-transform hover:-translate-y-0.5"
        >
          vikrantsharma892@gmail.com →
        </a>
      </div>

      <ul class="mono grid grid-cols-1 gap-1 self-end lg:col-span-5">
        {
          links.map((l) => (
            <li class="border-t border-[var(--color-ink-on-dark-muted)]/20 first:border-t-0">
              <a
                href={l.href}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center justify-between py-4 text-sm transition-colors hover:text-[var(--color-amber)]"
              >
                <span class="ds-eyebrow" style="color: var(--color-ink-on-dark-muted)">
                  {l.label}
                </span>
                <span class="text-[var(--color-ink-on-dark)] transition-transform group-hover:translate-x-1">
                  {l.value} →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mono mt-24 flex flex-col items-start justify-between gap-4 border-t border-[var(--color-ink-on-dark-muted)]/20 pt-8 text-xs text-[var(--color-ink-on-dark-muted)] sm:flex-row sm:items-center"
    >
      <p>© 2026 Vikrant Sharma · Adelaide, Australia · en-AU</p>
      <p>
        Built from scratch with Astro 5 + Tailwind 4 — see
        <a href="https://github.com/Vikrant892/portfolio-2026" class="underline">
          source ↗
        </a>
      </p>
    </div>
  </div>
</footer>
