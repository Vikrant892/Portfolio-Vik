---
// Pull the 3 most recent blog posts from vikrant69g.com/blog/rss.xml at build time.
// Failing the fetch (e.g. local dev without internet) renders a graceful empty state.
interface BlogPost {
  title: string;
  link: string;
  pubDate: string;
  description: string;
}

let posts: BlogPost[] = [];
try {
  const res = await fetch('https://vikrant69g.com/blog/rss.xml', {
    headers: { 'User-Agent': 'portfolio-2026-build' },
  });
  if (res.ok) {
    const xml = await res.text();
    const itemMatches = xml.match(/<item>[\s\S]*?<\/item>/g) ?? [];
    posts = itemMatches.slice(0, 3).map((item) => {
      const pick = (tag: string) => {
        const m = item.match(new RegExp(`<${tag}>([\\s\\S]*?)<\\/${tag}>`));
        return m ? m[1].replace(/<!\[CDATA\[|\]\]>/g, '').trim() : '';
      };
      return {
        title: pick('title'),
        link: pick('link'),
        pubDate: pick('pubDate'),
        description: pick('description'),
      };
    });
  }
} catch {
  posts = [];
}

const formatDate = (s: string) => {
  if (!s) return '';
  const d = new Date(s);
  return Number.isNaN(d.getTime())
    ? s
    : d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<section
  id="blog"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="blog-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">FROM THE BLOG</p>
        <h2
          id="blog-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Field notes<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <a
        href="https://vikrant69g.com/blog"
        class="mono text-sm text-[var(--color-ink)] underline-offset-4 hover:text-[var(--color-amber)] hover:underline lg:col-span-5 lg:text-right"
      >
        Read all posts →
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="mono text-sm text-[var(--color-ink-muted)]">
        Posts loading — check back when the blog feed is reachable.
      </p>
    ) : (
      <ul class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-3">
        {posts.map((p) => (
          <li>
            <a
              href={p.link}
              class="group block h-full bg-[var(--color-bg-elevated)] p-8 transition-colors hover:bg-[var(--color-bg)]"
            >
              <p class="mono text-xs text-[var(--color-amber)]">{formatDate(p.pubDate)}</p>
              <h3 class="display-script mt-3 text-2xl text-[var(--color-ink)] group-hover:text-[var(--color-amber)]">
                {p.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {p.description}
              </p>
              <p class="mono mt-6 text-xs text-[var(--color-ink-dim)]">Read post →</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
