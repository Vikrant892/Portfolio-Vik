---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const certs = (await getCollection('certifications')).sort((a, b) => {
  // Explicit order field drives the sequence. Falls back to most-recent
  // issuedAt when two entries share the same order value.
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.issuedAt.getTime() - a.data.issuedAt.getTime();
});

const monthYear = (d: Date) =>
  d.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' });
---

<section
  id="certifications"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-subtle)] py-24 sm:py-32"
  aria-labelledby="certs-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">VERIFIED CERTIFICATIONS</p>
        <h2
          id="certs-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Receipts<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <p class="text-base text-[var(--color-ink-muted)] lg:col-span-5">
        {certs.length} verified certifications, conferences, and recognitions —
        click any card to view the certificate or verify online.
      </p>
    </div>

    {
      certs.length === 0 ? (
        <p class="mono text-sm text-[var(--color-ink-muted)]">
          Certifications loading — content collection empty.
        </p>
      ) : (
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {certs.map((c) => (
            <li>
              <a
                href={c.data.verifyUrl ?? '#certifications'}
                target={c.data.verifyUrl ? '_blank' : undefined}
                rel={c.data.verifyUrl ? 'noopener noreferrer' : undefined}
                class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-card)]"
              >
                {c.data.certImage && (
                  <div class="aspect-[4/3] overflow-hidden border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)]">
                    <Image
                      src={c.data.certImage}
                      alt={`${c.data.title} certificate`}
                      widths={[400, 600, 800]}
                      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      class="h-full w-full object-contain object-center transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <p class="mono text-xs uppercase tracking-widest text-[var(--color-amber)]">
                    {c.data.issuer}
                  </p>
                  <h3 class="display-script mt-3 text-xl text-[var(--color-ink)]">
                    {c.data.title}
                  </h3>
                  <dl class="mono mt-4 grid grid-cols-2 gap-3 text-xs">
                    <div>
                      <dt class="ds-eyebrow">Issued</dt>
                      <dd class="mt-0.5 text-[var(--color-ink)]">
                        {monthYear(c.data.issuedAt)}
                      </dd>
                    </div>
                    {c.data.credentialId && (
                      <div>
                        <dt class="ds-eyebrow">Credential</dt>
                        <dd class="mt-0.5 truncate text-[var(--color-ink)]">
                          {c.data.credentialId}
                        </dd>
                      </div>
                    )}
                  </dl>
                  {c.data.tags.length > 0 && (
                    <ul class="mono mt-5 flex flex-wrap gap-1.5">
                      {c.data.tags.slice(0, 4).map((t) => (
                        <li class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-[10px] text-[var(--color-ink-dim)]">
                          #{t}
                        </li>
                      ))}
                    </ul>
                  )}
                  {c.data.verifyUrl && (
                    <span class="mono mt-auto pt-6 text-xs text-[var(--color-ink)] group-hover:text-[var(--color-amber)]">
                      Verify ↗
                    </span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
