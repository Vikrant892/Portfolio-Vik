---
const experiences = [
  {
    period: '2025 topresent',
    role: 'Master of Information and Communication Technology',
    org: 'University of the Sunshine Coast (Adelaide Campus)',
    location: 'Adelaide, AU',
    desc: 'Postgraduate IT, focused on data systems, software engineering, and cybersecurity research. Working alongside studies on the projects and demos linked from this site.',
    tags: ['Data Systems', 'Software Engineering', 'Cybersecurity', 'Research'],
  },
  {
    period: 'Dec 2024 toFeb 2025',
    role: 'Data Engineer',
    org: 'Nagarro',
    location: 'Adelaide, AU',
    desc: 'Designed and optimised data models for AWS Redshift and Snowflake data lakes. Agile/Scrum delivery, analytics for enterprise clients.',
    tags: ['Python', 'SQL', 'Redshift', 'Snowflake', 'ETL'],
  },
  {
    period: 'May 2023 toDec 2023',
    role: 'Cybersecurity Junior Analyst',
    org: 'AT SecurDI',
    location: 'Ahmedabad, IN',
    desc: 'SIEM monitoring, alert triage, incident response runbooks, OWASP Top 10 web/app testing, ISO 27001 + NIST CSF compliance audits.',
    tags: ['SIEM', 'OWASP', 'NIST CSF', 'ISO 27001', 'Incident Response'],
  },
];
---

<section
  id="experience"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16">
      <p class="ds-eyebrow mb-4">EXPERIENCE &amp; SKILLS</p>
      <h2
        id="experience-heading"
        class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
      >
        Where I've worked<span class="text-[var(--color-amber)]">.</span>
      </h2>
    </div>

    <ol class="relative border-l-2 border-[var(--color-border)] pl-8 sm:pl-12">
      {
        experiences.map((e) => (
          <li class="group relative mb-16 last:mb-0">
            <span
              aria-hidden="true"
              class="absolute -left-[2.4rem] top-2 h-3 w-3 rounded-full border-2 border-[var(--color-ink)] bg-[var(--color-bg)] transition-colors group-hover:bg-[var(--color-amber)] sm:-left-[3.4rem]"
            />
            <p class="mono text-xs uppercase tracking-widest text-[var(--color-amber)]">
              {e.period}
            </p>
            <h3 class="display-script mt-2 text-3xl text-[var(--color-ink)] sm:text-4xl">
              {e.role}
            </h3>
            <p class="mono mt-2 text-sm text-[var(--color-ink-muted)]">
              {e.org} · {e.location}
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-ink-muted)]">
              {e.desc}
            </p>
            <ul class="mono mt-4 flex flex-wrap gap-2">
              {e.tags.map((t) => (
                <li class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3 py-1 text-xs text-[var(--color-ink-dim)]">
                  {t}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
