---
import { Image } from 'astro:assets';
import idsImg from '../../assets/projects/ids-project.png';
import threatLensImg from '../../assets/projects/threat-lens.png';
import nasaImg from '../../assets/projects/nasa-space-challenge.png';
import fraudImg from '../../assets/projects/credit-card-fraud-detection.png';
import passwordImg from '../../assets/projects/password-strength-api.png';
import logImg from '../../assets/projects/log-analyzer-dashboard.png';
import phishingImg from '../../assets/projects/phishing-detection-platform.png';

const projects = [
  {
    n: '01',
    title: 'Hybrid ML Intrusion Detection',
    category: 'Cybersecurity / ML',
    img: idsImg,
    desc: 'My capstone. Real-time intrusion detection for SOC analysts. Every alert is mapped to MITRE ATT&CK so triage takes seconds, not minutes. Detects the attack categories CICIDS2017 covers: DDoS, brute force, port scans, web attacks, infiltration, botnet.',
    stack: ['Python', 'PyTorch', 'Scapy', 'Streamlit', 'Docker'],
    live: 'https://huggingface.co/spaces/vikrant892/ids-project',
    github: 'https://github.com/Vikrant892/ids-project',
  },
  {
    n: '02',
    title: 'ThreatLens',
    category: 'Threat Intelligence',
    img: threatLensImg,
    desc: 'Cuts SOC alert triage time. Pre-ranks new CVEs against exploit availability, asset exposure, and MITRE techniques so the alerts that actually matter rise to the top. Signal-to-noise is the whole point.',
    stack: ['FastAPI', 'NVD API', 'MITRE ATT&CK', 'Pydantic'],
    live: 'https://huggingface.co/spaces/vikrant892/threat-lens',
    github: 'https://github.com/Vikrant892/threat-lens',
  },
  {
    n: '03',
    title: 'Cosmic Keys (NASA Finalist)',
    category: 'Data Science / Sonification',
    img: nasaImg,
    desc: 'NASA Space Apps Global Finalist 2023 with Team Eklavya. Makes planetary data audible: latitude, velocity, and temperature become piano notes. An image scanner turns a planet photo into a melody.',
    stack: ['Python', 'Streamlit', 'NumPy', 'PIL'],
    live: 'https://huggingface.co/spaces/vikrant892/nasa-space-challenge',
    github: 'https://github.com/Vikrant892/nasa-space-challenge',
  },
  {
    n: '04',
    title: 'Phishing Detection Platform',
    category: 'Cybersecurity / ML',
    img: phishingImg,
    desc: 'Catches phishing patterns email gateways miss. Header anomalies, hidden payloads, suspicious URLs, sender spoofing. A second opinion for security teams before they click quarantine.',
    stack: ['Flask', 'SQLite', 'BeautifulSoup', 'Docker'],
    live: 'https://huggingface.co/spaces/vikrant892/phishing-detection-platform',
    github: 'https://github.com/Vikrant892/Phishing-detection-platform',
  },
  {
    n: '05',
    title: 'Credit Card Fraud Detection',
    category: 'ML / Data Science',
    img: fraudImg,
    desc: 'The hardest version of fraud detection: 0.17 percent positive class on 284k transactions. Without the right balance technique, a model hits 99 percent accuracy by predicting nothing. The work is in the threshold, not the algorithm.',
    stack: ['XGBoost', 'scikit-learn', 'SMOTE', 'Streamlit'],
    live: 'https://huggingface.co/spaces/vikrant892/credit-card-fraud-detection',
    github: 'https://github.com/Vikrant892/credit-card-fraud-detection',
  },
  {
    n: '06',
    title: 'Log Analyzer Dashboard',
    category: 'Cybersecurity / SIEM',
    img: logImg,
    desc: 'A SIEM for teams without a Splunk budget. Parses syslog and web access logs, flags brute force + port scans in seconds, maps every alert to MITRE ATT&CK. Spins up on a single VM.',
    stack: ['Flask', 'Chart.js', 'Regex', 'Docker'],
    live: 'https://huggingface.co/spaces/vikrant892/log-analyzer-dashboard',
    github: 'https://github.com/Vikrant892/log-analyzer-dashboard',
  },
  {
    n: '07',
    title: 'Password Strength API',
    category: 'Security / API',
    img: passwordImg,
    desc: 'Drop-in password check for any auth flow. Returns entropy, breach status (without the server ever seeing the password), and crack-time estimates in under 100 milliseconds.',
    stack: ['FastAPI', 'HIBP API', 'Docker'],
    live: 'https://huggingface.co/spaces/vikrant892/password-strength-api',
    github: 'https://github.com/Vikrant892/password-strength-api',
  },
];
---

<section
  id="projects"
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg)] py-24 sm:py-32"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-[1400px] px-6 sm:px-12">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="ds-eyebrow mb-4">RECENT PROJECTS, ALL LIVE, NO MOCKUPS</p>
        <h2
          id="projects-heading"
          class="display-script text-5xl text-[var(--color-ink)] sm:text-7xl"
        >
          Things I've shipped<span class="text-[var(--color-amber)]">.</span>
        </h2>
      </div>
      <p class="text-base text-[var(--color-ink-muted)] lg:col-span-5">
        Every "Live" link below points at a real running deployment. Click any of them.
        They may take 30 seconds to wake from sleep, then the actual ML / API runs.
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <li>
            <article class="group relative h-full overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
              <div class="aspect-[16/10] overflow-hidden bg-[var(--color-bg-subtle)]">
                <Image
                  src={p.img}
                  alt={`Screenshot of ${p.title}`}
                  widths={[480, 720, 1080]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  class="h-full w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <div class="flex items-baseline justify-between">
                  <p class="mono text-xs text-[var(--color-amber)]">{p.n}</p>
                  <p class="mono text-xs text-[var(--color-ink-dim)]">{p.category}</p>
                </div>
                <h3 class="display-script mt-3 text-2xl text-[var(--color-ink)]">
                  {p.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                  {p.desc}
                </p>
                <ul class="mono mt-4 flex flex-wrap gap-1.5">
                  {p.stack.map((s) => (
                    <li class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-[10px] text-[var(--color-ink-dim)]">
                      {s}
                    </li>
                  ))}
                </ul>
                <div class="mono mt-6 flex flex-wrap gap-2 text-xs">
                  <a
                    href={p.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-ink)] px-4 py-2 font-medium text-[var(--color-ink-on-dark)] transition-transform hover:-translate-y-0.5"
                  >
                    Open live demo
                    <span aria-hidden="true">↗</span>
                  </a>
                  <a
                    href={p.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border-strong)] px-4 py-2 text-[var(--color-ink)] transition-colors hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
                  >
                    Source on GitHub
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
