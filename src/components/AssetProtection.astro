---
// Client-side download/inspection friction. Deters the right-click +
// "save image as" path and the common keyboard shortcuts for DevTools,
// view-source, save-page, and print. This is *friction*, not security:
// determined users can still grab assets via the Network tab, browser
// cache, screenshot, or curl. Real protection requires server-side
// signed URLs or watermarking, which is a much bigger lift.
---

<script is:inline>
  (() => {
    // Allow context menu in form fields so users can still paste, copy
    // their email, etc. Anything with data-allow-context="true" is also
    // exempt (none of our components set this today).
    document.addEventListener(
      'contextmenu',
      (event) => {
        const target = event.target;
        if (
          target instanceof Element &&
          target.closest('input, textarea, [contenteditable], [data-allow-context="true"]')
        ) {
          return;
        }
        event.preventDefault();
      },
      true,
    );

    // Block image drag-to-save and image-drag onto desktop.
    document.addEventListener(
      'dragstart',
      (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      },
      true,
    );

    // Block selecting an image element (kills the "right-click then save")
    // shortcut on iPad/iPhone where long-press triggers a save sheet.
    document.addEventListener(
      'selectstart',
      (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      },
      true,
    );

    // Common keyboard shortcuts that lead to download or inspection.
    // Note: this is bypassable by anyone who knows the menu paths in the
    // browser chrome. It is here to slow down casual users.
    document.addEventListener(
      'keydown',
      (event) => {
        const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
        const ctrl = event.ctrlKey || event.metaKey;
        const shift = event.shiftKey;

        if (key === 'F12') {
          event.preventDefault();
          return;
        }
        // DevTools open shortcuts
        if (ctrl && shift && (key === 'i' || key === 'j' || key === 'c')) {
          event.preventDefault();
          return;
        }
        // View source, save page, print
        if (ctrl && (key === 'u' || key === 's' || key === 'p')) {
          event.preventDefault();
          return;
        }
      },
      true,
    );
  })();
</script>

<style is:global>
  /* Stop the long-press save sheet on iOS and the drag-and-drop save
     gesture on desktop. user-select stays auto on the body so text is
     selectable in articles and forms. */
  img,
  picture,
  video,
  source {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    pointer-events: auto;
  }
</style>
